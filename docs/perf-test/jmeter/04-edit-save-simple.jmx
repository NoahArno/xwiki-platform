      <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="生成认证头" enabled="true">
            <stringProp name="cacheKey"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">import java.util.Base64
String uname = vars.get("perf.user")
String pwd = vars.get("perf.pass")
vars.put("authHeader", "Basic " + Base64.getEncoder().encodeToString((uname + ":" + pwd).getBytes("UTF-8")))
vars.put("saveContent", new File(vars.get("perf.saveContentFile")).getText("UTF-8"))</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
