    <!-- RocketMQ 客户端（DOAP 用户数据 MQ 消费）
         RocketMQ 5.x 起 remoting 不再依赖 fastjson，但 rocketmq-common 仍传递依赖 fastjson
         1.2.83。fastjson 1.x 内置 Jersey 2 时代的 JAX-RS 钩子（META-INF/services/
         org.glassfish.jersey.internal.spi.AutoDiscoverable + com/alibaba/fastjson/support/
         jaxrs/*），在 XWiki 18（Jersey 3 / jakarta.ws.rs）下会触发
         javax.ws.rs.core.FeatureContext ClassNotFoundException / AbstractMethodError，
         因此必须排除；经全量字节码扫描，5.5.0 的 common/remoting/client 没有任何类引用
         fastjson 1.x，排除不影响 MQ 运行（5.x 内部序列化用 fastjson2，其无 JAX-RS 钩子）。 -->
    <dependency>
      <groupId>org.apache.rocketmq</groupId>
      <artifactId>rocketmq-client</artifactId>
      <version>5.5.0</version>
      <exclusions>
        <!-- rocketmq-common 传递进来的 fastjson 1.2.83 带 Jersey 2 的 JAX-RS 钩子，
             在 XWiki 18（Jersey 3 / jakarta.ws.rs）下报错；5.x 代码不使用 fastjson 1.x，
             直接排除 -->
        <exclusion>
          <groupId>com.alibaba</groupId>
          <artifactId>fastjson</artifactId>
        </exclusion>
        <!-- rocketmq-common 声明的 OTel exporter（otlp/prometheus/logging/logging-otlp）
             在 1.44.1 且传递引入 sdk-metrics/sdk-logs 1.44.1 与 okio 3.6.0，与 XWiki 管理的
             OTel 1.59.0 冲突（RequireUpperBoundDeps）；经全量字节码扫描，5.5.0 的
             common/remoting/client 没有任何类引用 exporter/okhttp 包，纯为 pom 冗余依赖，
             直接排除。5.5.0 运行时只需要 opentelemetry-api/context/sdk-metrics，由 XWiki
             的 1.59.0 提供/对齐 -->
        <exclusion>
          <groupId>io.opentelemetry</groupId>
          <artifactId>opentelemetry-exporter-otlp</artifactId>
        </exclusion>
        <exclusion>
          <groupId>io.opentelemetry</groupId>
          <artifactId>opentelemetry-exporter-prometheus</artifactId>
        </exclusion>
        <exclusion>
          <groupId>io.opentelemetry</groupId>
          <artifactId>opentelemetry-exporter-logging</artifactId>
        </exclusion>
        <exclusion>
          <groupId>io.opentelemetry</groupId>
          <artifactId>opentelemetry-exporter-logging-otlp</artifactId>
        </exclusion>
        <!-- rocketmq-common 的 commons-validator 传递依赖 commons-logging，
             XWiki 禁用 commons-logging（用 jcl-over-slf4j 桥接），否则发行包 enforcer 的
             enforce-jcl-log4j-isolation 规则会构建失败 -->
        <exclusion>
          <groupId>commons-logging</groupId>
          <artifactId>commons-logging</artifactId>
        </exclusion>
        <!-- rocketmq-common 传递进来的 netty-all 4.1.x 会与平台自带 netty 4.2（Solr/
             ZooKeeper 依赖）冲突，运行时由平台自带 netty 提供；DOAP MQ 默认关闭
             （xwiki.doap-mq.enabled=false），启用前需验证与平台 netty 4.2 的兼容性 -->
        <exclusion>
          <groupId>io.netty</groupId>
          <artifactId>netty-all</artifactId>
        </exclusion>
        <exclusion>
          <groupId>io.netty</groupId>
          <artifactId>netty-tcnative-boringssl-static</artifactId>
        </exclusion>
      </exclusions>
    </dependency>

    <!-- Test dependencies -->
    <dependency>
