  'SMALL': 'btn-sm',
  'MEDIUM': '',
  'LARGE': 'btn-lg'
})
#set ($iconMap = {
  'CHECK': 'check',
  'INFO': 'info',
  'WARNING': 'warning',
  'STAR': 'star',
  'PLUS': 'add',
  'PENCIL': 'pencil',
  'TRASH': 'trash',
  'SEARCH': 'search',
  'HOME': 'home',
  'COG': 'cog',
  'ENVELOPE': 'envelope',
  'USER': 'user',
  'LINK': 'link',
  'DOWNLOAD': 'download',
  'RIGHT': 'right'
})
#set ($colorClass = $colorClassMap.get($color))
#if ("$!colorClass" == '')
  #set ($colorClass = 'btn-primary')
#end
#set ($discard = $buttonClasses.add($colorClass))
#set ($sizeClass = $sizeClassMap.get($size))
#if ($sizeClass == $NULL)
  #set ($sizeClass = '')
#end
#if ($sizeClass != '')
  #set ($discard = $buttonClasses.add($sizeClass))
#end
#if ($display == 'BLOCK')
  #set ($discard = $buttonClasses.add('btn-block'))
#end
#set ($buttonClassString = $stringtool.join($buttonClasses, ' '))
#set ($iconMarkup = '')
