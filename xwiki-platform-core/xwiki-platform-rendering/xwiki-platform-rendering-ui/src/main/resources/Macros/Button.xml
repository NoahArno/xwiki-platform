#if ("$!iconName" != '' &amp;&amp; $services.icon)
  #set ($iconMarkup = "$services.icon.renderHTML($iconName)")
#end
#set ($tooltipAttribute = '')
#if ("$!tooltip" != '')
  #set ($tooltipAttribute = " title='$tooltip'")
#end
#set ($separator = '')
#if ($iconMarkup != '')
  #set ($separator = ' ')
#end
#if ("$!link" != '')
  #set ($html = "&lt;a href='$link' class='$buttonClassString' role='button'$tooltipAttribute&gt;$iconMarkup$separator&lt;span class='button-macro-label'&gt;$title&lt;/span&gt;&lt;/a&gt;")
#else
  #set ($html = "&lt;button type='button' class='$buttonClassString'$tooltipAttribute&gt;$iconMarkup$separator&lt;span class='button-macro-label'&gt;$title&lt;/span&gt;&lt;/button&gt;")
#end
#set ($output = "{{html clean='false'}}&lt;div class='button-macro-wrapper'&gt;$html&lt;/div&gt;{{/html}}")
