  <content>{{velocity}}
#set ($obj = $doc.getObject('XWiki.XWikiUsers'))
#if (!$obj)
{{info}}This tab is available only on user profile pages.{{/info}}
#else
  #set ($profileUserName = $doc.documentReference.name)
  #set ($personalSpaceReference = $services.model.createDocumentReference($xcontext.database, ['People', $profileUserName], 'WebHome'))
  #set ($spaceExists = $xwiki.exists($personalSpaceReference))
  #set ($isOwnProfile = $xcontext.userReference.name == $profileUserName)
  #set ($isWikiAdmin = $services.security.authorization.hasAccess('admin', $xcontext.databaseReference))
  #set ($spaceManagerURL = $xwiki.getURL('XWiki.SpaceManager', 'view', "action=viewPersonalSpace&amp;user=${escapetool.url($profileUserName)}"))
  #set ($personalSpaceURL = $xwiki.getURL($personalSpaceReference))

= Personal Space =

{{html clean="false"}}
&lt;p&gt;Use a personal space to store your personal home page, notes, drafts and blog posts.&lt;/p&gt;
{{/html}}

  #if ($spaceExists)
{{success}}
This personal space is initialized.
{{/success}}

[[Open personal space&gt;&gt;${services.model.serialize($personalSpaceReference, 'default')}]]
  #elseif ($isOwnProfile || $isWikiAdmin)
{{warning}}
This personal space has not been initialized yet.
{{/warning}}

{{html clean="false"}}
&lt;a href="$escapetool.xml($spaceManagerURL)" class="btn btn-primary"&gt;Create and open personal space&lt;/a&gt;
{{/html}}
  #else
{{info}}
This personal space has not been initialized yet.
{{/info}}
  #end
#end
{{/velocity}}</content>
