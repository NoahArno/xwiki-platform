      <content>{{velocity}}{{html clean="false"}}
## Space Switcher Dropdown for the top menu.
## Displays quick links for the spaces area.
#if ($xcontext.action == 'view')
  #template('menus_macros.vm')
  ## Render dropdown
  #set ($label = $services.localization.render('spaces.switcher.label'))
  &lt;li class="dropdown"&gt;
    &lt;a href="#" class="dropdown-toggle" data-toggle="dropdown"&gt;
      $services.icon.renderHTML('folder') ${label} &lt;b class="caret"&gt;&lt;/b&gt;
    &lt;/a&gt;
    &lt;ul class="dropdown-menu"&gt;
      &lt;li&gt;&lt;a href="$xwiki.getURL('Spaces.WebHome')"&gt;$services.localization.render('spaces.switcher.viewAll')&lt;/a&gt;&lt;/li&gt;
      &lt;li&gt;&lt;a href="$xwiki.getURL('Spaces.CreateSpace')"&gt;$services.localization.render('spaces.switcher.createSpace')&lt;/a&gt;&lt;/li&gt;
    &lt;/ul&gt;
  &lt;/li&gt;
#end
{{/html}}{{/velocity}}</content>
