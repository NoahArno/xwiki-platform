  <web>Spaces</web>
  <name>CreateSpace</name>
  <language/>
  <defaultLanguage/>
  <translation>0</translation>
  <creator>xwiki:XWiki.Admin</creator>
  <parent>Spaces.WebHome</parent>
  <author>xwiki:XWiki.Admin</author>
  <contentAuthor>xwiki:XWiki.Admin</contentAuthor>
  <version>1.1</version>
  <title>Create Space</title>
  <comment/>
  <minorEdit>false</minorEdit>
  <syntaxId>xwiki/2.1</syntaxId>
  <hidden>true</hidden>
  <enforceRequiredRights>true</enforceRequiredRights>
  <content>{{velocity}}
#set($title = $services.localization.render('spaces.create.title'))
#set($discard = $doc.setTitle($title))

= ${title} =

#if ($request.spaceName &amp;&amp; $request.spaceKey &amp;&amp; $request.spaceName != '')
  ## Create the space
  #set ($spaceName = $request.spaceName)
  #set ($spaceKey = $request.spaceKey)
  #set ($spaceDesc = $!request.spaceDescription)
  #set ($spaceHomeFull = "${spaceKey}.WebHome")
  #set ($spaceDoc = $xwiki.getDocument($spaceHomeFull))
  #if (!$spaceDoc.isNew())
    {{error}}$services.localization.render('spaces.create.error.exists', [$escapetool.xml($spaceKey)]){{/error}}
  #else
    #set ($spaceObj = $spaceDoc.newObject('SpaceCode.SpaceClass'))
    $!spaceObj.set('name', $spaceName)
    $!spaceObj.set('key', $spaceKey)
    $!spaceObj.set('description', $spaceDesc)
    $!spaceObj.set('type', 'public')
    $!spaceObj.set('owner', $xcontext.user)
    #set ($discard = $spaceDoc.save('Created space: ' + $spaceName))
    {{success}}$services.localization.render('spaces.create.success', [$escapetool.xml($spaceName), $spaceHomeFull]){{/success}}
    [[$services.localization.render('spaces.create.gotoSpace')&gt;&gt;$spaceHomeFull]]
  #end
#else
  ## Display creation form
  {{html clean="false"}}
  &lt;form method="post" action="$doc.getURL('view')" class="xform"&gt;
    &lt;dl&gt;
      &lt;dt&gt;&lt;label for="spaceName"&gt;$services.localization.render('spaces.create.name')&lt;/label&gt;&lt;/dt&gt;
      &lt;dd&gt;&lt;input type="text" id="spaceName" name="spaceName" size="40" required="required" /&gt;&lt;/dd&gt;
      &lt;dt&gt;&lt;label for="spaceKey"&gt;$services.localization.render('spaces.create.key')&lt;/label&gt;&lt;/dt&gt;
      &lt;dd&gt;&lt;input type="text" id="spaceKey" name="spaceKey" size="40" required="required" /&gt;&lt;/dd&gt;
      &lt;dt&gt;&lt;label for="spaceDescription"&gt;$services.localization.render('spaces.create.description')&lt;/label&gt;&lt;/dt&gt;
      &lt;dd&gt;&lt;textarea id="spaceDescription" name="spaceDescription" rows="4" cols="40"&gt;&lt;/textarea&gt;&lt;/dd&gt;
    &lt;/dl&gt;
    &lt;p&gt;
      &lt;span class="buttonwrapper"&gt;
        &lt;input type="submit" class="button" value="$services.localization.render('spaces.create.submit')" /&gt;
      &lt;/span&gt;
    &lt;/p&gt;
  &lt;/form&gt;
  {{/html}}
#end
{{/velocity}}</content>
